root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 110

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.ps1]
# Windows PowerShell 5.1 reads a script as UTF-8 only when it starts with a byte order mark.
charset = utf-8-bom

# Test fixtures are kept byte for byte.
[tests/fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[vendor/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
