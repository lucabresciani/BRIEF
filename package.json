{
  "name": "brief",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free, open-source, local-first lab companion for STEM students: plot, fit and export measurements in the browser.",
  "keywords": [
    "science",
    "education",
    "stem",
    "physics",
    "laboratory",
    "data-visualization",
    "plotting",
    "curve-fitting",
    "least-squares",
    "statistics",
    "uncertainty",
    "error-bars",
    "spreadsheet",
    "csv",
    "local-first",
    "offline",
    "pwa",
    "plotly",
    "react"
  ],
  "homepage": "https://github.com/lucabresciani/BRIEF#readme",
  "bugs": {
    "url": "https://github.com/lucabresciani/BRIEF/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lucabresciani/BRIEF.git"
  },
  "license": "MIT",
  "author": "Luca Bresciani (https://github.com/lucabresciani)",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.domain.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:dist": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run e2e:dist"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "idb-keyval": "6.3.0",
    "immer": "11.1.21",
    "lucide-react": "1.52.0",
    "papaparse": "5.7.0",
    "plotly.js": "4.1.2",
    "plotly.js-cartesian-dist-min": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-plotly.js": "4.1.0",
    "react-resizable-panels": "4.14.2",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
